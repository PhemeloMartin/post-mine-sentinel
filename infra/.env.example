# Copy to infra/.env and replace every value. infra/.env is git-ignored. Never reuse these in production
# (production secrets live in Azure Key Vault and are injected by the Secrets Store CSI driver).
POSTGRES_PASSWORD=change-me-postgres
JWT_SECRET=change-me-to-a-random-64-character-string-0123456789abcdefghijkl
INGEST_TOKEN=change-me-ingest-service-token
DEMO_PASSWORD=change-me-demo-password
GRAFANA_PASSWORD=change-me-grafana
